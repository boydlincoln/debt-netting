    <debt:message xml:lang="zh">债务人与债权人为同一主体，数据错误，不进入轧差池。</debt:message>
    <debt:legalBasis xml:lang="zh">抵销须为互负债务的两个主体之间的安排。</debt:legalBasis>
    <swrl:body>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
