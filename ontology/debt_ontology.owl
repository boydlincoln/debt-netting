<?xml version="1.0" encoding="UTF-8"?>
<!--
  三角债抵销与净额轧差本体（OWL 2 DL + SWRL 规则）
  ==================================================
  规则资产单独保存在本文件中，可随业务规则迭代更新；本地规则引擎
  （app/ontology.py）读取本文件并对每笔债务推理“是否允许抵销”与分组。

  规则中的派生属性（hasMatured / hasPriority / hasSelfDealing /
  hasAmountPositive）由本地引擎在实例化时依据业务数据计算：
    hasMatured       = 到期日 <= 基准日
    hasPriority      = 顺位分组 != ordinary
    hasSelfDealing   = 债务人与债权人相同
    hasAmountPositive= 债务金额 > 0
  新增规则时只需在本体末尾追加 swrl:Imp，无需改动求解与前端模块。
-->
<rdf:RDF
    xml:base="http://example.org/debt"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:swrl="http://www.w3.org/2003/11/swrl#"
    xmlns:debt="http://example.org/debt#">

  <owl:Ontology rdf:about="http://example.org/debt">
    <rdfs:label xml:lang="zh">三角债抵销与净额轧差本体</rdfs:label>
    <owl:versionInfo>1.0</owl:versionInfo>
    <rdfs:comment xml:lang="zh">定义债务领域的实体类、属性、关系与抵销资格规则，是系统规则的单一可信来源。规则以 SWRL 表达，金额计算与方案求解不依赖线上模型。</rdfs:comment>
  </owl:Ontology>

  <!-- ==================== 实体类 ==================== -->
  <owl:Class rdf:about="#LegalEntity">
    <rdfs:label xml:lang="zh">主体</rdfs:label>
    <rdfs:comment xml:lang="zh">债权人、债务人、担保人等参与方。含名称、统一社会信用代码、账户、经营状态、可动用资金、涉诉与被执行标记等。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#DebtObligation">
    <rdfs:label xml:lang="zh">债权债务关系</rdfs:label>
    <rdfs:comment xml:lang="zh">一笔具体的债权债务记录。含本金、金额、利息、到期日、是否逾期、是否争议、是否查封、担保类型、是否允许抵销等。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Asset">
    <rdfs:label xml:lang="zh">资产</rdfs:label>
    <rdfs:comment xml:lang="zh">可用于清偿的货币、应收款、存货、不动产、设备、股权等，预留以物抵债场景。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#SettlementPlan">
    <rdfs:label xml:lang="zh">清偿方案</rdfs:label>
    <rdfs:comment xml:lang="zh">一组轧差与清偿安排，含对冲金额、现金支付金额、履约时间、风险等级与优先顺序校验。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#PriorityClaim">
    <rdfs:label xml:lang="zh">优先顺位债权</rdfs:label>
    <rdfs:subClassOf rdf:resource="#DebtObligation"/>
    <rdfs:comment xml:lang="zh">抵押、工资、税款等优先顺位债权，单独分组、不与普通债权混算。</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#IneligibleDebt">
    <rdfs:label xml:lang="zh">不可抵销债务</rdfs:label>
    <rdfs:subClassOf rdf:resource="#DebtObligation"/>
    <rdfs:comment xml:lang="zh">被推理器判定为不满足抵销条件的债务，不进入净额轧差池。</rdfs:comment>
  </owl:Class>

  <!-- ==================== 对象属性 ==================== -->
  <owl:ObjectProperty rdf:about="#hasCreditor">
    <rdfs:label xml:lang="zh">债权人</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="#LegalEntity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasDebtor">
    <rdfs:label xml:lang="zh">债务人</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="#LegalEntity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#guaranteedBy">
    <rdfs:label xml:lang="zh">担保方</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="#LegalEntity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#settlesDebt">
    <rdfs:label xml:lang="zh">方案涉及债务</rdfs:label>
    <rdfs:domain rdf:resource="#SettlementPlan"/>
    <rdfs:range rdf:resource="#DebtObligation"/>
  </owl:ObjectProperty>

  <!-- ==================== 数据属性 ==================== -->
  <owl:DatatypeProperty rdf:about="#hasName">
    <rdfs:label xml:lang="zh">名称</rdfs:label>
    <rdfs:domain rdf:resource="#LegalEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasCreditCode">
    <rdfs:label xml:lang="zh">统一社会信用代码</rdfs:label>
    <rdfs:domain rdf:resource="#LegalEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasAvailableCash">
    <rdfs:label xml:lang="zh">可动用资金</rdfs:label>
    <rdfs:domain rdf:resource="#LegalEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="zh">用于资金约束与分期清偿提示，不改变净额轧差的金额与笔数。</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasAmount">
    <rdfs:label xml:lang="zh">债务金额</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasPrincipal">
    <rdfs:label xml:lang="zh">本金</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasInterest">
    <rdfs:label xml:lang="zh">利息</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasDueDate">
    <rdfs:label xml:lang="zh">到期日</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasDisputed">
    <rdfs:label xml:lang="zh">是否存在争议</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasFrozen">
    <rdfs:label xml:lang="zh">是否被查封冻结</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasNoSetoffClause">
    <rdfs:label xml:lang="zh">是否约定禁止抵销</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasPriorityGroup">
    <rdfs:label xml:lang="zh">债权顺位分组</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="zh">ordinary=普通债权；mortgage=抵押优先；wage=职工工资；tax=税款；custom=其他优先。</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasStatus">
    <rdfs:label xml:lang="zh">确认状态</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasSource">
    <rdfs:label xml:lang="zh">数据来源</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasMatured">
    <rdfs:label xml:lang="zh">是否已到期（派生）</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasPriority">
    <rdfs:label xml:lang="zh">是否优先顺位（派生）</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasSelfDealing">
    <rdfs:label xml:lang="zh">是否债权债务同体（派生）</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasAmountPositive">
    <rdfs:label xml:lang="zh">金额是否为正（派生）</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasSetoffEligibility">
    <rdfs:label xml:lang="zh">是否允许抵销（推理结论）</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#hasGroupCode">
    <rdfs:label xml:lang="zh">轧差分组代码（推理结论）</rdfs:label>
    <rdfs:domain rdf:resource="#DebtObligation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <!-- ==================== SWRL 抵销资格规则 ==================== -->

  <!-- R1 争议债务不得参与抵销 -->
  <swrl:Imp rdf:about="#R1_DisputedNotSetoff">
    <debt:ruleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R1</debt:ruleId>
    <debt:order rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</debt:order>
    <debt:ruleName xml:lang="zh">存在争议的债务不得参与抵销</debt:ruleName>
    <debt:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blocking</debt:severity>
    <debt:message xml:lang="zh">该笔债务存在金额或事实争议，不进入自动轧差池，需人工与法务核实。</debt:message>
    <debt:legalBasis xml:lang="zh">《民法典》第五百六十八条：抵销要求债务标的确定、无争议；争议债务应先经确认。</debt:legalBasis>
    <swrl:body>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#DebtObligation"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatatypePropertyAtom"/>
        <swrl:propertyPredicate rdf:resource="#hasDisputed"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
      </rdf:Description>
    </swrl:body>
    <swrl:head>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#IneligibleDebt"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
    </swrl:head>
  </swrl:Imp>

  <!-- R2 被查封、冻结的债务不得参与抵销 -->
  <swrl:Imp rdf:about="#R2_FrozenNotSetoff">
    <debt:ruleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R2</debt:ruleId>
    <debt:order rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</debt:order>
    <debt:ruleName xml:lang="zh">被查封、冻结的债务不得参与抵销</debt:ruleName>
    <debt:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blocking</debt:severity>
    <debt:message xml:lang="zh">该笔债务已被查封或冻结，处分受限，不进入自动轧差池。</debt:message>
    <debt:legalBasis xml:lang="zh">被查封、冻结的债权处分受限，法定抵销条件不成立，应待解封后重新评估。</debt:legalBasis>
    <swrl:body>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#DebtObligation"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatatypePropertyAtom"/>
        <swrl:propertyPredicate rdf:resource="#hasFrozen"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
      </rdf:Description>
    </swrl:body>
    <swrl:head>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#IneligibleDebt"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
    </swrl:head>
  </swrl:Imp>

  <!-- R3 尚未到期的金钱债权不得参与抵销 -->
  <swrl:Imp rdf:about="#R3_NotMaturedNotSetoff">
    <debt:ruleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R3</debt:ruleId>
    <debt:order rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</debt:order>
    <debt:ruleName xml:lang="zh">尚未到期的金钱债权不得参与抵销</debt:ruleName>
    <debt:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blocking</debt:severity>
    <debt:message xml:lang="zh">该笔债务在基准日尚未到期，不满足法定抵销的到期条件，不进入自动轧差池。</debt:message>
    <debt:legalBasis xml:lang="zh">《民法典》第五百六十八条：抵销要求双方债务均已到期。</debt:legalBasis>
    <swrl:body>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#DebtObligation"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatatypePropertyAtom"/>
        <swrl:propertyPredicate rdf:resource="#hasMatured"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
      </rdf:Description>
    </swrl:body>
    <swrl:head>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#IneligibleDebt"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
    </swrl:head>
  </swrl:Imp>

  <!-- R4 合同约定禁止抵销的债务不得参与抵销 -->
  <swrl:Imp rdf:about="#R4_NoSetoffClause">
    <debt:ruleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R4</debt:ruleId>
    <debt:order rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</debt:order>
    <debt:ruleName xml:lang="zh">合同约定禁止抵销的债务不得参与抵销</debt:ruleName>
    <debt:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blocking</debt:severity>
    <debt:message xml:lang="zh">该笔债务所在合同约定禁止抵销，尊重当事人意思自治，不进入自动轧差池。</debt:message>
    <debt:legalBasis xml:lang="zh">当事人可以约定不得抵销；有约定时不得以单方意思表示抵销。</debt:legalBasis>
    <swrl:body>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#DebtObligation"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatatypePropertyAtom"/>
        <swrl:propertyPredicate rdf:resource="#hasNoSetoffClause"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
      </rdf:Description>
    </swrl:body>
    <swrl:head>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#IneligibleDebt"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
    </swrl:head>
  </swrl:Imp>

  <!-- R5 优先顺位债权分组隔离 -->
  <swrl:Imp rdf:about="#R5_PriorityIsolation">
    <debt:ruleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R5</debt:ruleId>
    <debt:order rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</debt:order>
    <debt:ruleName xml:lang="zh">优先顺位债权单独分组、不与普通债权混算</debt:ruleName>
    <debt:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">info</debt:severity>
    <debt:message xml:lang="zh">该笔债权属于优先顺位（抵押、工资、税款等），在所属分组内独立计算，不与普通债权跨组轧差。</debt:message>
    <debt:legalBasis xml:lang="zh">优先顺位债权依法定顺序受偿，不与普通债权随意互抵。</debt:legalBasis>
    <swrl:body>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#DebtObligation"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatatypePropertyAtom"/>
        <swrl:propertyPredicate rdf:resource="#hasPriority"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl:argument2>
      </rdf:Description>
    </swrl:body>
    <swrl:head>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatatypePropertyAtom"/>
        <swrl:propertyPredicate rdf:resource="#hasGroupCode"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">priority</swrl:argument2>
      </rdf:Description>
    </swrl:head>
  </swrl:Imp>

  <!-- R6 金额非正，转人工复核 -->
  <swrl:Imp rdf:about="#R6_AmountNotPositive">
    <debt:ruleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R6</debt:ruleId>
    <debt:order rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</debt:order>
    <debt:ruleName xml:lang="zh">债务金额必须大于零</debt:ruleName>
    <debt:severity rdf:datatype="http://www.w3.org/2001/XMLSchema#string">review</debt:severity>
    <debt:message xml:lang="zh">债务金额为零或负数，数据存在异常，转人工复核，不进入自动轧差池。</debt:message>
    <debt:legalBasis xml:lang="zh">抵销以确定、合法的金钱债权为前提，金额异常应先核实。</debt:legalBasis>
    <swrl:body>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#DebtObligation"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatatypePropertyAtom"/>
        <swrl:propertyPredicate rdf:resource="#hasAmountPositive"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
        <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</swrl:argument2>
      </rdf:Description>
    </swrl:body>
    <swrl:head>
      <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
        <swrl:classPredicate rdf:resource="#IneligibleDebt"/>
        <swrl:argument1><swrl:Variable rdf:about="#d"/></swrl:argument1>
      </rdf:Description>
    </swrl:head>
  </swrl:Imp>

  <!-- R7 债权债务同体，数据错误 -->
  <swrl:Imp rdf:about="#R7_SelfDealing">
    <debt:ruleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R7</debt:ruleId>
    <debt:order rdf:datatype="http://www.w3.org/2001/XMLSchema#int">70</debt:order>
